# Banco de dados legado do Nexus Flow (não publicar credenciais reais).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase Auth, obtenha em Supabase Dashboard > Connect > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Necessária apenas em uma migração administrativa de usuários existentes.
# Nunca usar o prefixo NEXT_PUBLIC nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# URLs do app usadas em redirecionamentos de autenticação.
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Pluggy (somente no servidor; nunca use NEXT_PUBLIC_ nestas chaves)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo aleatório usado para autenticar os webhooks anexados ao Connect Token.
# Em produção, gere um valor longo e diferente das credenciais da Pluggy.
PLUGGY_WEBHOOK_SECRET=
PLUGGY_INCLUDE_SANDBOX=true

# Assistente financeiro com Groq (plano gratuito suficiente para uso pessoal).
# Crie a chave em https://console.groq.com/keys. Nunca use NEXT_PUBLIC aqui.
GROQ_API_KEY=
# Opcional. Se este modelo sair do catálogo, o app tenta automaticamente os
# modelos estáveis definidos no backend.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

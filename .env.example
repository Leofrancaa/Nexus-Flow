# Banco de dados legado do Nexus Flow (não publicar credenciais reais).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase Auth, obtenha em Supabase Dashboard > Connect > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Necessária apenas em uma migração administrativa de usuários existentes.
# Nunca usar o prefixo NEXT_PUBLIC nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# URLs do app usadas em redirecionamentos de autenticação.
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Pluggy (somente no servidor; nunca use NEXT_PUBLIC_ nestas chaves)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_INCLUDE_SANDBOX=true

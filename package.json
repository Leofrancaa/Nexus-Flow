{
  "name": "nexus-flow",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de controle financeiro pessoal - Frontend Next.js",
  "author": "Leonardo Franca Almeida Silva",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true npm run build",
    "clean": "rm -rf .next out",
    "clean:win": "rmdir /s /q .next out",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postbuild": "echo \"✅ Build completed successfully!\"",
    "deploy": "vercel --prod",
    "preview": "vercel"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@emailjs/browser": "^4.4.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-select": "2.3.7",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "12.43.0",
    "lucide-react": "^0.534.0",
    "next": "15.5.23",
    "pg": "8.23.0",
    "pluggy-connect-sdk": "2.12.0",
    "pluggy-js": "0.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "2.6.0",
    "react-icons": "5.7.0",
    "react-pluggy-connect": "2.12.0",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.6.0",
    "unpdf": "1.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@eslint/eslintrc": "3.3.6",
    "@next/bundle-analyzer": "15.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "@types/date-fns": "^2.5.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vercel": "58.11.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <13.0.0"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "finance",
    "dashboard",
    "personal-finance"
  ]
}
